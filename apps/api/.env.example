# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpportal
JWT_SECRET=change-me-in-production
PORT=3000
# Comma-separated origins allowed to call the API in dev (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- Recording storage ---
# "local" writes to ./storage on disk. "s3" works with AWS S3, Cloudflare R2 or MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers ---
# Leave empty to use the built-in mock providers (the app still works end to end).
DEEPGRAM_API_KEY=
# Summaries: auto | anthropic | gemini | mock (auto = Anthropic if keyed, else Gemini, else mock)
SUMMARY_PROVIDER=auto
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5-5
# Gemini has a free tier (aistudio.google.com). Models are tried in order.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite,gemini-flash-lite-latest

# --- WebRTC ---
# JSON array of RTCIceServer objects. Default is Google's public STUN server.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Optional Cloudflare TURN key (Cloudflare dashboard -> Realtime -> TURN). When set, each user gets
# short-lived TURN credentials, so calls also connect through strict NATs / corporate firewalls.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
